# SmartQP – Configuration Environment Variables

# Security
SECRET_KEY=smartqp-faculty-production-jwt-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is local SQLite for instant setup. For PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smartqp_db
DATABASE_URL=sqlite:///./smartqp.db

# Google Gemini API
# Supported models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Question Paper Generation Settings
SIMILARITY_THRESHOLD=0.85
MAX_RETRY_COUNT=4

# Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
